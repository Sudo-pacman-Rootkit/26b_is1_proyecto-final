autonumber
actor "Profesor / Alumno" as A
boundary "Pantalla del catálogo" as UI
control "Servicio de catálogo" as S
database "Base de\ndatos" as DB
A -> UI : Abre el catálogo
UI -> S : pedir tipos activos
S -> DB : consultar tipos activos
DB --> S : tipos
alt catálogo vacío
  S --> UI : aviso
  UI --> A : "No hay tipos de examen registrados"
else
  S --> UI : tipos y requisitos
  UI --> A : confirmación
end
