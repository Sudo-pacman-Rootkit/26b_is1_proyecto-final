skinparam noteBackgroundColor #FFF7E6
skinparam noteBorderColor #B7791F
autonumber
actor "Personal de Control Escolar" as A
boundary "Formulario de\ntipo de examen" as UI
control "Servicio de catálogo" as S
database "Base de\ndatos" as DB
A -> UI : Captura clave, nombre y requisitos
UI -> S : registrar tipo
S -> DB : buscar la clave
DB --> S : resultado
alt clave repetida
  S --> UI : aviso
  UI --> A : "Ya existe un tipo con esa clave"
else
  S -> DB : guardar tipo (Activo)
  S --> UI : tipo registrado
  UI --> A : confirmación
end
@enduml
