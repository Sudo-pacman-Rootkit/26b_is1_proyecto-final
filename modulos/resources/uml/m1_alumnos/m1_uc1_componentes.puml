@startuml
title UC1 - Registrar alumno y generar matrícula - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Control Escolar" as Admin
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    component "Generador de Matrícula" as Gen
    database "Base de Datos" as BD
}

Admin --> UI : Captura datos del alumno
UI --> Ctrl : Envía solicitud de alta
Ctrl --> Gen : Solicita matrícula única
Ctrl --> BD : Verifica CURP y guarda expediente
@enduml