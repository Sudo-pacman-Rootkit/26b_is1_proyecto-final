@startuml
title UC4 - Cambiar estatus / Dar de baja alumno - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Control Escolar" as Admin
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    database "Base de Datos" as BD
}

Admin --> UI : Selecciona nuevo estatus y motivo
UI --> Ctrl : Solicita cambio de estatus
Ctrl --> BD : Actualiza estatus y guarda bitácora
@enduml