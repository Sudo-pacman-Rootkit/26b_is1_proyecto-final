@startuml
title UC3 - Modificar datos académicos - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Control Escolar" as Admin
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    database "Base de Datos" as BD
}
component "Módulo Asignaturas" as Asig

Admin --> UI : Edita carrera, plan o semestre
UI --> Ctrl : Envía cambios académicos
Ctrl --> Asig : Verifica plan de estudios válido
Ctrl --> BD : Actualiza datos del alumno
@enduml