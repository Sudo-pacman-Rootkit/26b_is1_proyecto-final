@startuml
title UC8 - Descargar constancia de estudios (PDF) - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Alumno" as A
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Documentos" as Ctrl
    component "Generador de PDF" as PDF
    database "Base de Datos" as BD
}
component "Módulo Periodo" as Per
component "Módulo Inscripciones" as Insc

A --> UI : Solicita constancia PDF
UI --> Ctrl : Genera constancia
Ctrl --> BD : Verifica estatus "Activo" y guarda folio
Ctrl --> Per : Consulta periodo activo
Ctrl --> Insc : Verifica inscripción vigente
Ctrl --> PDF : Construye archivo PDF
@enduml