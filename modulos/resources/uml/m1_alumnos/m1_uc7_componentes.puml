@startuml
title UC7 - Consultar historial académico (Kárdex) - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Alumno" as A
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    database "Base de Datos" as BD
}
component "Módulo Calificaciones" as Cal
component "Módulo Asignaturas" as Asig

A --> UI : Solicita Kárdex
UI --> Ctrl : Pide historial académico
Ctrl --> Cal : Consulta notas oficializadas
Ctrl --> Asig : Consulta créditos del plan
Ctrl --> BD : Obtiene datos del alumno
@enduml