@startuml
title UC2 - Consultar alumnos - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Control Escolar" as Admin
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    database "Base de Datos" as BD
}

Admin --> UI : Ingresa matrícula o nombre
UI --> Ctrl : Solicita búsqueda
Ctrl --> BD : Consulta expedientes
@enduml