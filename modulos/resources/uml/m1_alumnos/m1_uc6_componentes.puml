@startuml
title UC6 - Editar datos de contacto y domicilio - Componentes
left to right direction
skinparam componentStyle rectangle

actor "Alumno" as A
package "Módulo de Alumnos" {
    component "Interfaz Web" as UI
    component "Controlador de Alumnos" as Ctrl
    database "Base de Datos" as BD
}

A --> UI : Modifica teléfono, correo o domicilio
UI --> Ctrl : Envía datos de contacto
Ctrl --> BD : Actualiza campos permitidos
@enduml