@startuml
' === ESTILO HOMOLOGADO EQUIPO 1 (ACTIVIDAD 3) ===
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1B365D
skinparam ArrowFontColor #1B365D
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
}
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #1E3A8A
    FontColor #1E3A8A
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    FontColor #0F172A
}
skinparam usecase {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    FontColor #0C4A6E
}
skinparam component {
    BackgroundColor #DBEAFE
    BorderColor #1D4ED8
    FontColor #1E3A8A
}
skinparam database {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
}
skinparam sequence {
    ParticipantBackgroundColor #DBEAFE
    ParticipantBorderColor #1D4ED8
    ParticipantFontColor #1E3A8A
    BoundaryBackgroundColor #E0F2FE
    BoundaryBorderColor #0284C7
    ControlBackgroundColor #DCFCE7
    ControlBorderColor #15803D
    LifeLineBorderColor #64748B
}
skinparam activity {
    BackgroundColor #DBEAFE
    BorderColor #1D4ED8
    FontColor #1E3A8A
    DiamondBackgroundColor #FEF3C7
    DiamondBorderColor #D97706
}
skinparam state {
    BackgroundColor #E0F2FE
    BorderColor #0369A1
    FontColor #0C4A6E
}
skinparam class {
    BackgroundColor #F0F9FF
    BorderColor #0284C7
    HeaderBackgroundColor #0284C7
    FontColor #0F172A
}
title Diagrama de Clases - Módulo de Alumnos e Integración
skinparam classAttributeIconSize 0

class Usuario <<externo - Autenticación>> {
  + idUsuario : int
  + correoInstitucional : String
  + activo : boolean
}

class Alumno {
  + matricula : String
  + nombre : String
  + apellidos : String
  + curp : String
  + semestre : int
  + estatus : EstatusAlumno
  + telefono : String
  + correoAlterno : String
  + domicilio : String
  + promedioGeneral : float
  + creditosAcumulados : int
  + generarMatricula() : String
  + actualizarContacto() : boolean
  + cambiarEstatus(nuevo : EstatusAlumno) : void
}

enum EstatusAlumno {
  ACTIVO
  BAJA_TEMPORAL
  BAJA_DEFINITIVA
  EGRESADO
}

class ConstanciaEstudios {
  + idConstancia : int
  + folio : String
  + fechaEmision : DateTime
  + cicloVigente : String
  + generarPDF() : byte[]
}

class BitacoraEstatus {
  + idMovimiento : int
  + estatusAnterior : EstatusAlumno
  + estatusNuevo : EstatusAlumno
  + motivo : String
  + fechaMovimiento : DateTime
}

class PlanEstudios <<externo - Asignaturas>> {
  + clavePlan : String
  + nombreCarrera : String
  + creditosTotales : int
}

class PeriodoEscolar <<externo - Periodo>> {
  + clavePeriodo : String
  + activo : boolean
}

class Inscripcion <<externo - Inscripciones>> {
  + folio : String
  + estado : String
}

class Calificacion <<externo - Calificaciones>> {
  + valor : float
  + oficializada : boolean
}

Usuario <|-- Alumno
Alumno --> EstatusAlumno
Alumno "1" --> "0..*" ConstanciaEstudios : solicita
Alumno "1" --> "0..*" BitacoraEstatus : registra
Alumno "0..*" --> "1" PlanEstudios : cursa
Alumno "1" --> "0..*" Inscripcion : realiza
Alumno "1" --> "0..*" Calificacion : obtiene
ConstanciaEstudios "0..*" --> "1" PeriodoEscolar : corresponde a
@enduml
