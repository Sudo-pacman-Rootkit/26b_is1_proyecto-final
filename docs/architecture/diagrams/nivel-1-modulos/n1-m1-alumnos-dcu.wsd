@startuml
' === ESTILO HOMOLOGADO EQUIPO 1 (ACTIVIDAD 3) ===
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #1B365D
skinparam ArrowFontColor #1B365D
skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
}
skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #1E3A8A
    FontColor #1E3A8A
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #1E3A8A
    FontColor #0F172A
}
skinparam usecase {
    BackgroundColor #E0F2FE
    BorderColor #0284C7
    FontColor #0C4A6E
}
skinparam component {
    BackgroundColor #DBEAFE
    BorderColor #1D4ED8
    FontColor #1E3A8A
}
skinparam database {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
}
skinparam sequence {
    ParticipantBackgroundColor #DBEAFE
    ParticipantBorderColor #1D4ED8
    ParticipantFontColor #1E3A8A
    BoundaryBackgroundColor #E0F2FE
    BoundaryBorderColor #0284C7
    ControlBackgroundColor #DCFCE7
    ControlBorderColor #15803D
    LifeLineBorderColor #64748B
}
skinparam activity {
    BackgroundColor #DBEAFE
    BorderColor #1D4ED8
    FontColor #1E3A8A
    DiamondBackgroundColor #FEF3C7
    DiamondBorderColor #D97706
}
skinparam state {
    BackgroundColor #E0F2FE
    BorderColor #0369A1
    FontColor #0C4A6E
}
skinparam class {
    BackgroundColor #F0F9FF
    BorderColor #0284C7
    HeaderBackgroundColor #0284C7
    FontColor #0F172A
}
left to right direction
skinparam packageStyle rectangle

actor "Control Escolar /\nAdministrador" as Admin
actor "Alumno" as A

rectangle "Módulo de Alumnos" {
    usecase "UC1: Registrar alumno y\ngenerar matrícula" as UC1
    usecase "UC2: Consultar alumnos" as UC2
    usecase "UC3: Modificar datos\nacadémicos del alumno" as UC3
    usecase "UC4: Cambiar estatus /\nDar de baja alumno" as UC4

    usecase "UC5: Consultar datos\npersonales y académicos" as UC5
    usecase "UC6: Editar datos de\ncontacto y domicilio" as UC6
    usecase "UC7: Consultar historial\nacadémico (Kárdex)" as UC7
    usecase "UC8: Descargar constancia\nde estudios (PDF)" as UC8
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4

A --> UC5
A --> UC6
A --> UC7
A --> UC8
@enduml
